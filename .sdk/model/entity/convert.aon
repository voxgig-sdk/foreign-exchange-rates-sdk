# Entity: convert

main: kit: entity: convert: {

  alias: field: {}

  fields: [
    {
      name: "conversions"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "from"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "pairs"
      req: true
      short: "Array of [targetCurrency, amount] tuples."
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    from: {
      from: "from"
    }
    name: "id"
    parts: [
      "from"
      "to"
      "amount"
    ]
    sep: "/"
  }

  name: "convert"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/v1/convert"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "convert"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 100
                kind: "param"
                name: "amount"
                orig: "amount"
                reqd: true
                type: "`$NUMBER`"
              }
              {
                example: "USD"
                kind: "param"
                name: "from"
                orig: "from"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "EUR"
                kind: "param"
                name: "to"
                orig: "to"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/convert/{from}/{to}/{amount}"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "convert"
            }
            {
              var: "from"
            }
            {
              var: "to"
            }
            {
              var: "amount"
            }
          ]
          select: {
            exist: [
              "amount"
              "from"
              "to"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "convert"
      ]
    ]
  }



}
